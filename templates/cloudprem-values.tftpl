# Do not edit cloudprem-values.yaml manually. It is generated by Terraform from cloudprem-values.tftpl.

fullnameOverride: "${FULLNAME_OVERRIDE}" 

nameOverride: "${NAME_OVERRIDE}"

datadog:
  site: ${DATADOG_SITE}
  apiKeyExistingSecret: datadog-secret

cloudprem:
  index:
    retention: "${INDEX_RETENTION}d"

aws:
  accountId: "${AWS_ACCOUNT_ID}"

serviceAccount:
  name: ${SERVICE_ACCOUNT_NAME}

config:
  cluster_id: "${CLUSTER_ID}"
  default_index_root_uri: "s3://${S3_BUCKET_ID}/indexes"

metastore:
  replicaCount: 1
  extraEnvFrom:
    - secretRef:
        name: cloudprem-metastore-uri

ingress:
  internal:
%{ if INTERNAL_LB_NAME != null && INTERNAL_LB_NAME != "" ~}
    extraAnnotations:
      alb.ingress.kubernetes.io/load-balancer-name: ${INTERNAL_LB_NAME}
%{ else ~}
    extraAnnotations: {}
%{ endif ~}

control_plane:
  resources:
    requests:
      cpu: 1        # default: 2
      memory: 1Gi   # default: 4Gi

janitor:
  resources:
    requests:
      cpu: 1        # default: 2
      memory: 1Gi   # default: 4Gi

indexer:
  autoscaling:
    enabled: true   # When autoscaling is enabled, indexer.replicaCount is ignored.
    minReplicas: 1
    maxReplicas: 3
    behavior:
      scaleUp:
        stabilizationWindowSeconds: 30    # default: 60
      scaleDown:
        stabilizationWindowSeconds: 120   # default: 300
  resources:
    requests:
      cpu: "2"      # default: 4
      memory: 2Gi   # default: 16Gi
    limits:
      cpu: "4"
      memory: 4Gi   # default: 16Gi

searcher:
  autoscaling:
    enabled: true   # When autoscaling is enabled, searcher.replicaCount is ignored.
    minReplicas: 1
    maxReplicas: 3
    behavior:
      scaleUp:
        stabilizationWindowSeconds: 30    # default: 60
      scaleDown:
        stabilizationWindowSeconds: 120   # default: 300
  resources:
    requests:
      cpu: "2"      # default: 4
      memory: 4Gi   # default: 16Gi
    limits:
      cpu: "4"
      memory: 8Gi   # default: 16Gi
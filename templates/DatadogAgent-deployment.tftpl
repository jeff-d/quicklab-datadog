# Do not edit DatadogAgent-deployment.yaml manually. It is generated by Terraform from DatadogAgent-deployment.tftpl.

apiVersion: datadoghq.com/v2alpha1
kind: DatadogAgent
metadata:
  name: datadog
  namespace: ${DATADOG_OPERATOR_NAMESPACE}
spec:
  global:
    site: ${DATADOG_SITE}
    credentials:
      apiSecret:
        secretName: ${DATADOG_KEYS_SECRET}
        keyName: api-key
      appSecret:
        secretName: ${DATADOG_KEYS_SECRET}
        keyName: app-key
%{ if CLOUDPREM_INDEXER_URL != "" ~}
    env:
      - name: DD_LOGS_CONFIG_LOGS_DD_URL
        value: "${CLOUDPREM_INDEXER_URL}"
      - name: DD_LOGS_CONFIG_FORCE_USE_HTTP
        value: "true"
      # Must carry a unit: a bare number is parsed as nanoseconds, so "100000" silently
      # became 100µs. CloudPrem does no backend tag enrichment, so host-level tags have to
      # be attached by the Agent at send time.
      - name: DD_LOGS_CONFIG_EXPECTED_TAGS_DURATION
        value: "87600h"
%{ endif ~}
  features:
    # Reference: https://github.com/DataDog/datadog-operator/blob/main/examples/datadogagent/datadog-agent-all.yaml
    logCollection:
      enabled: ${DATADOG_AGENT_DEPLOYMENT.features.logCollection}
      containerCollectAll: ${DATADOG_AGENT_DEPLOYMENT.features.logCollectionContainerAll}
    liveProcessCollection:
      enabled: ${DATADOG_AGENT_DEPLOYMENT.features.liveProcessCollection}
    liveContainerCollection:
      enabled: ${DATADOG_AGENT_DEPLOYMENT.features.liveContainerCollection}
    processDiscovery:
      enabled: ${DATADOG_AGENT_DEPLOYMENT.features.processDiscovery}
    oomKill:
      enabled: ${DATADOG_AGENT_DEPLOYMENT.features.oomKill}
    tcpQueueLength:
      enabled: ${DATADOG_AGENT_DEPLOYMENT.features.tcpQueueLength}
    ebpfCheck:
      enabled: ${DATADOG_AGENT_DEPLOYMENT.features.ebpfCheck}
    apm:
      instrumentation:
        enabled: ${DATADOG_AGENT_DEPLOYMENT.features.apm}
    asm:
      threats:
        enabled: ${DATADOG_AGENT_DEPLOYMENT.features.asmThreats}
      sca:
        enabled: ${DATADOG_AGENT_DEPLOYMENT.features.asmSca}
      iast:
        enabled: ${DATADOG_AGENT_DEPLOYMENT.features.asmIast}
    cspm:
      enabled: ${DATADOG_AGENT_DEPLOYMENT.features.cspm}
    cws:
      enabled: ${DATADOG_AGENT_DEPLOYMENT.features.cws}
    npm:
      enabled: ${DATADOG_AGENT_DEPLOYMENT.features.npm}
    usm:
      enabled: ${DATADOG_AGENT_DEPLOYMENT.features.usm}
    dogstatsd:
      unixDomainSocketConfig:
        enabled: ${DATADOG_AGENT_DEPLOYMENT.features.dogstatsdUnixDomainSocket}
    otlp:
      receiver:
        protocols:
          grpc:
            enabled: ${DATADOG_AGENT_DEPLOYMENT.features.otlpGrpc}
    remoteConfiguration:
      enabled: ${DATADOG_AGENT_DEPLOYMENT.features.remoteConfiguration}
    sbom:
      enabled: ${DATADOG_AGENT_DEPLOYMENT.features.sbom}
      containerImage:
        enabled: ${DATADOG_AGENT_DEPLOYMENT.features.sbomContainerImage}
      host:
        enabled: ${DATADOG_AGENT_DEPLOYMENT.features.sbomHost}
    serviceDiscovery:
      enabled: ${DATADOG_AGENT_DEPLOYMENT.features.serviceDiscovery}
      networkStats:
        enabled: ${DATADOG_AGENT_DEPLOYMENT.features.serviceDiscoveryNetworkStats}
    gpu:
      enabled: ${DATADOG_AGENT_DEPLOYMENT.features.gpu}
    eventCollection:
      collectKubernetesEvents: ${DATADOG_AGENT_DEPLOYMENT.features.collectKubernetesEvents}
    orchestratorExplorer:
      enabled: ${DATADOG_AGENT_DEPLOYMENT.features.orchestratorExplorer}
    kubeStateMetricsCore:
      enabled: ${DATADOG_AGENT_DEPLOYMENT.features.kubeStateMetricsCore}
    admissionController:
      enabled: ${DATADOG_AGENT_DEPLOYMENT.features.admissionController}
    externalMetricsServer:
      enabled: ${DATADOG_AGENT_DEPLOYMENT.features.externalMetricsServer}
    clusterChecks:
      enabled: ${DATADOG_AGENT_DEPLOYMENT.features.clusterChecks}
    prometheusScrape:
      enabled: ${DATADOG_AGENT_DEPLOYMENT.features.prometheusScrape}
  override:
    nodeAgent:
      tolerations:
        - key: karpenter.sh/controller
          operator: Exists
          effect: NoSchedule
    clusterAgent:
      tolerations:
        - key: karpenter.sh/controller
          operator: Exists
          effect: NoSchedule

# Do not edit DatadogAgent-deployment.yaml manually. It is generated by Terraform from DatadogAgent-deployment.tftpl.

apiVersion: datadoghq.com/v2alpha1
kind: DatadogAgent
metadata:
  name: datadog
  namespace: ${DATADOG_OPERATOR_NAMESPACE}
spec:
  global:
    site: ${DATADOG_SITE}
    credentials:
      apiKey: ${DATADOG_API_KEY}
      appKey: ${DATADOG_APP_KEY}
  override:
    nodeAgent:
      tolerations:
        - key: karpenter.sh/controller
          operator: Exists
          effect: NoSchedule
    clusterAgent:
      tolerations:
        - key: karpenter.sh/controller
          operator: Exists
          effect: NoSchedule
